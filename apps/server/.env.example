DATABASE_URL=postgresql://opensheet:opensheet@localhost:5432/opensheet
# Public origin of the web app (used in emails and the Origin check)
APP_URL=http://localhost:5173
# Optional: nodemailer connection URL, e.g. smtp://user:pass@smtp.example.go.id:587
# Without it, emails are printed to the server log.
SMTP_URL=
MAIL_FROM=OpenSheet <no-reply@localhost>
MAX_UPLOAD_MB=10
SNAPSHOT_EVERY=100
# Set to 1 behind a reverse proxy (Nginx, Caddy) so secure cookies and client IPs work
TRUST_PROXY=0

# --- Capacity ---
# PostgreSQL connections per process (keep WORKERS x DB_POOL_MAX below max_connections)
DB_POOL_MAX=20
# Worker processes. More than 1 needs REDIS_URL.
WORKERS=1
REDIS_URL=
# Rate limits: logins per IP per 15 min (many users can share one office IP),
# logins per IP + email per 15 min, API requests per user per minute.
LOGIN_IP_LIMIT=3000
LOGIN_ACCOUNT_LIMIT=10
API_RATE_LIMIT=600

# --- Original upload storage: local | s3 | none ---
STORAGE=local
STORAGE_DIR=./data/uploads
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=1
